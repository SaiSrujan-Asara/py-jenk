FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILDKIT_VERSION=0.26.2
ARG TRIVY_VERSION=0.69.3
ARG SONAR_SCANNER_VERSION=8.1.0.6389
ARG JAVA_VERSION=21
ARG DEBIAN_FRONTEND=noninteractive
ARG JAVA_VERSION=21

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gzip \
    tar \
    unzip \
    openjdk-${JAVA_VERSION}-jre-headless \
    maven \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Trivy
RUN curl -fsSL \
    "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
    -o /tmp/trivy.tar.gz \
    && tar -xzf /tmp/trivy.tar.gz -C /tmp trivy \
    && install -m 0755 /tmp/trivy /usr/local/bin/trivy \
    && rm -f /tmp/trivy.tar.gz

# Install BuildKit CLI only
RUN curl -fsSL \
    "https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-amd64.tar.gz" \
    -o /tmp/buildkit.tar.gz \
    && tar -xzf /tmp/buildkit.tar.gz -C /tmp \
    && install -m 0755 /tmp/bin/buildctl /usr/local/bin/buildctl \
    && rm -rf /tmp/bin /tmp/buildkit.tar.gz

# Install SonarScanner CLI
RUN curl -fsSL \
    "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-${SONAR_SCANNER_VERSION}-linux-x64.zip" \
    -o /tmp/sonar.zip \
    && unzip /tmp/sonar.zip -d /opt \
    && ln -s "/opt/sonar-scanner-${SONAR_SCANNER_VERSION}-linux-x64/bin/sonar-scanner" \
       /usr/local/bin/sonar-scanner \
    && rm -f /tmp/sonar.zip

ENV PATH="/usr/local/bin:/opt/sonar-scanner-${SONAR_SCANNER_VERSION}-linux-x64/bin:${PATH}"
ENV SONAR_USER_HOME="/tmp/.sonar"
ENV BUILDKIT_HOST="tcp://buildkitd.ci.svc.cluster.local:1234"

WORKDIR /workspace

# Verify installed tools
RUN git --version \
    && python3 --version \
    && java -version \
    && trivy --version \
    && buildctl --version \
    && sonar-scanner -v

CMD ["bash"]