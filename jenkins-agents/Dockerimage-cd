FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

# Tool versions
ARG KUBECTL_VERSION=v1.34.12
ARG HELM_VERSION=v4.3.1
ARG OC_VERSION=4.21.7

# Install system dependencies and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gzip \
    tar \
    unzip \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install kubectl with checksum verification
RUN curl -fsSLo /tmp/kubectl \
    "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && curl -fsSLo /tmp/kubectl.sha256 \
    "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl.sha256" \
    && echo "$(cat /tmp/kubectl.sha256)  /tmp/kubectl" | sha256sum -c - \
    && install -m 0755 /tmp/kubectl /usr/local/bin/kubectl \
    && rm -f /tmp/kubectl /tmp/kubectl.sha256

# Install Helm with checksum verification
RUN curl -fsSLo /tmp/helm.tar.gz \
    "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
    && curl -fsSLo /tmp/helm.tar.gz.sha256sum \
    "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz.sha256sum" \
    && cd /tmp \
    && echo "$(awk '{print $1}' helm.tar.gz.sha256sum)  helm.tar.gz" | sha256sum -c - \
    && tar -xzf helm.tar.gz \
    && install -m 0755 linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tar.gz /tmp/helm.tar.gz.sha256sum /tmp/linux-amd64

# Install OpenShift CLI (oc)
RUN curl -fsSLo /tmp/openshift-client-linux.tar.gz \
    "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/openshift-client-linux.tar.gz" \
    && tar -xzf /tmp/openshift-client-linux.tar.gz -C /tmp \
    && install -m 0755 /tmp/oc /usr/local/bin/oc \
    && rm -f /tmp/openshift-client-linux.tar.gz /tmp/oc /tmp/kubectl

WORKDIR /workspace

# Verify installed tools
RUN python3 --version \
    && python3 -m pip --version \
    && kubectl version --client \
    && helm version --short \
    && oc version

CMD ["bash"]