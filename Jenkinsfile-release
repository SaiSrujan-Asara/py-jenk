pipeline {
    agent{
        node {
            label "kubeagent"     //Pod Template label
        }
    }

    stages {

        stage('SETUP ENV'){
            steps{
                script{
                    def timestamp = new Date().format('yyyyMMdd-HHmmss', TimeZone.getTimeZone('UTC'))
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${timestamp}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }
        stage('CHECK OUT') {
            steps {
              git url: 'https://github.com/SaiSrujan-Asara/py-jenk.git/',
              branch: "${env.BRANCH_NAME}",
              credentialsId: 'github-repo1'
            }
        }

        stage('INSTALL PYTHON DEPENDECIES'){
            when{
                expression { isReleaseBranch() || isDevBranch() }
            }
            steps {
                script {
                    installPythonDependencies()
                }
            }
        }
        stage('OSS SCANNER'){
            when {
                expression { isReleaseBranch() || isDevBranch() }
            }
            options {
              timeout(time: 59, unit: 'MINUTES') 
            }
            steps {
                script {
                    runOSSScanner()
                }
            }
        }
        stage('SONAR QUBE STAGE'){
            when {
                expression { isReleaseBranch() || isDevBranch() }
            }
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
            steps{
                script{
                    runSonarQube()
                }
            }    
        }
        stage('TAG GENERATION FOR RELEASE BRANCH'){
            when{
                expression { isReleaseBranch() }
            }
            steps{
                script{
                    runTagGen()
                }

            }
        }
        stage('DOCKER IMAGE BUILD & PUSH') {
            options {
                timeout(time: 15, unit: 'MINUTES')
            }
             environment {
                REGISTRY = 'ghcr.io/saisrujan-asara'
                IMAGE_NAME = 'my-app'
            }
        
            steps {
                script {
                    buildAndPushDockerImage()
                }
            }
        }
        stage('HELM PACKAGE AND PUSH'){
            steps{
                container('cd-image') {
                    sh '''

                    IMAGE_TAG = "${BUILD_NUMBER}-${timestamp}"
                    
                    cd k8s
                    
                    helm lint ./app
                    
                    sleep 3

                    helm template ./app --set image_version=${IMAGE_TAG}

                    sleep 3
                    CHART_NAME="app"
                    CHART_VERSION="1.0.-${IMAGE_TAG}"
                    NEXUS_URL="https://nexus-ui-asarasaisrujan-dev.apps.rm1.0a51.p1.openshiftapps.com/repository/py-app/"


                    helm package ./app \
                    --version "${CHART_VERSION}" \
                    --app-version "${IMAGE_TAG}"

                    curl -u 'admin:Rich@0987654321' \
                    --upload-file "${CHART_NAME}-${CHART_VERSION}.tgz" \
                    "${NEXUS_URL}"
                    '''
                }
            } 
        }
        stage('OPEN SHIFT LOGIN'){
            steps{
                container('cd-image') {
                    withCredentials([string(credentialsId: 'openshift-k8s',variable: 'OPENSHIFT_TOKEN')]) 
                    {
                        sh '''
                            oc login https://api.rm1.0a51.p1.openshiftapps.com:6443 \
                            --token="$OPENSHIFT_TOKEN"

                            CHART_NAME="app"
                            CHART_VERSION="1.0.${IMAGE_TAG}"

                            NEXUS_URL="https://nexus-ui-asarasaisrujan-dev.apps.rm1.0a51.p1.openshiftapps.com/repository/py-app"

                            # 1. Download the exact package published to Nexus
                            curl --fail --silent --show-error \
                            --user "admin:Rich@0987654321" \
                            --output "${CHART_NAME}-${CHART_VERSION}.tgz" \
                            "${NEXUS_URL}/${CHART_NAME}-${CHART_VERSION}.tgz"

                            # 2. Install the downloaded package
                            helm upgrade --install myapp \
                            "./${CHART_NAME}-${CHART_VERSION}.tgz" \
                            --wait
                        '''
                    }
                }
            }
        }
    }
}

def getBranchName() {
    return env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
}

def isDevBranch() {
    def branch = getBranchName().replaceFirst(/^origin\//, '')

    return branch == 'main' ||
           branch == 'development1' ||
           branch.startsWith('feature/') ||
           branch.startsWith('bugfix/') ||
           branch.startsWith('PR-')
}

def isReleaseBranch() {
    return getBranchName() ==~ /release\/.+/
}

def installPythonDependencies() {
    container('ci-image') {
        sh '''
            python3 -m venv .venv
            .venv/bin/pip install \
                --cache-dir /pip-cache \
                --retries 10 \
                --timeout 120 \
                -r requirements.txt
        '''
    }
}


def runOSSScanner() {
    container('ci-image') {
        sh(script: '''
            .venv/bin/python oss.py
        ''', encoding: 'UTF-8')
    }
}

def runSonarQube() {
    container('ci-image') {
        sh '''
            export SONARQUBE_URL="http://sonarqube:9000"
            export PROJECT_KEY="py-app1"
            export TOKEN="sqp_1cd0b29a20244ee3276817345ff57fce2ee0e5ec"

            sonar-scanner \
                -Dsonar.host.url=$SONARQUBE_URL \
                -Dsonar.projectKey=$PROJECT_KEY \
                -Dsonar.token=$TOKEN

            echo "Sonar scanner scanned successfully"
            sleep 10

            .venv/bin/python sonar.py
        '''
    }
}



def runTagGen() {
    container('ci-image') {
        withCredentials([
            usernamePassword(
                credentialsId: 'ghcr',
                usernameVariable: 'GHCR_USER',
                passwordVariable: 'GHCR_PASS'
            )
        ]) {
            sh '''
                set +x
                set -e

                git config --global --add safe.directory "$PWD"
                git config user.email "jenkins@example.com"
                git config user.name "jenkins"

                .venv/bin/python git.py

                test -s tag.txt
            '''
        }

        env.IMAGE_TAG = readFile('tag.txt').trim()
        echo "Image tag: ${env.IMAGE_TAG}"
    }
}

def buildAndPushDockerImage() {
    container('ci-image') {
        withCredentials([
            usernamePassword(
                credentialsId: 'ghcr',
                usernameVariable: 'GHCR_USER',
                passwordVariable: 'GHCR_PASS'
            )
        ]) {
            sh '''
                set -eu

                echo "Building image: ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

                # Authenticate with GHCR
                export DOCKER_CONFIG="$(mktemp -d)"
                chmod 700 "$DOCKER_CONFIG"
                trap 'rm -rf "$DOCKER_CONFIG"' EXIT

                AUTH=$(printf '%s:%s' "$GHCR_USER" "$GHCR_PASS" | base64 | tr -d '\\n')

                printf '{"auths":{"ghcr.io":{"auth":"%s"}}}\\n' "$AUTH" \
                    > "$DOCKER_CONFIG/config.json"

                chmod 600 "$DOCKER_CONFIG/config.json"

                # Build and push using BuildKit
                buildctl \
                    --debug \
                    --addr tcp://buildkitd.default.svc.cluster.local:1234 \
                    build \
                    --progress=plain \
                    --frontend dockerfile.v0 \
                    --local context=. \
                    --local dockerfile=. \
                    --output "type=image,name=${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG},push=true"

                echo "Image successfully built and pushed."
            '''
        }
    }
}