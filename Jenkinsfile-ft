
pipeline {
    agent {
        kubernetes {
            yamlFile 'jenkins-agents/buildconfig.yaml'
            defaultContainer 'jnlp'
        }
    }
    environment{   
        NAMESPACE = 'prod'
        IMAGE_NAME = 'my-app'
        IMAGE_TAG = '26.10.119'
        IMAGE_REGISTRY = 'ghcr.io/saisrujan-asara'
        CHART_NAME = 'app'
        CHART_VERSION = "1.0.1-${BUILD_NUMBER}-Prod"
        APP_VERSION = "1.0.1-${BUILD_NUMBER}-Prod"
        CHART_REGISTRY = 'https://nexus-ui-asarasaisrujan-dev.apps.rm1.0a51.p1.openshiftapps.com/repository/py-app/'
    }


    stages {
        stage('Check FT access') {
            steps {
                container('cd-image') {
                    sh '''
                        set -eu
                        kubectl version
                        kubectl auth whoami
                        kubectl auth can-i create deployments -n prod
                        kubectl get deployments -n prod

                        kubectl auth can-i get secrets -n prod
                        kubectl auth can-i list secrets -n prod
                        kubectl auth can-i create secrets -n prod
                        kubectl auth can-i update secrets -n prod
                        kubectl auth can-i patch deployments -n prod
                        kubectl auth can-i create services -n prod
                    '''
                }
            }
        }
        stage('CHECK OUT') {
            steps {
                container('cd-image') {
                    git url: 'https://github.com/SaiSrujan-Asara/py-jenk.git/',
                    branch: "main",
                    credentialsId: 'github-repo1'
                }
            }
        }

        stage('HELM PACKAGE AND PUSH'){
            steps{
                container('cd-image') {
                    withCredentials([usernamePassword(credentialsId: 'nexus',usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) 
                    {
                        sh '''

                            cd k8s

                            rm -rf build
                            mkdir -p build
                            cp -a app build/app

                            cp app/values-prod.yaml build/app/values.yaml

                            # Update chart metadata
                            CHART_VERSION="${CHART_VERSION}" \
                            APP_VERSION="${APP_VERSION}" \
                            yq -i \
                              '.version = strenv(CHART_VERSION) |
                               .appVersion = strenv(APP_VERSION)' \
                              build/app/Chart.yaml

                            # Inject the image tag
                            IMAGE_TAG="${IMAGE_TAG}" yq -i \
                              '.image_version = strenv(IMAGE_TAG)' \
                              build/app/values.yaml

                            # Validate and render
                            helm lint build/app
                            helm template myapp build/app 

                            # Package
                            helm package build/app \
                            --destination build


                            PACKAGE="build/${CHART_NAME}-${CHART_VERSION}.tgz"

                            # Publish to Nexus
                            curl --fail-with-body --silent --show-error \
                            -u "${NEXUS_USER}:${NEXUS_PASS}" \
                            --upload-file "$PACKAGE" \
                            "${CHART_REGISTRY}${CHART_NAME}-${CHART_VERSION}.tgz"
                        '''
                    }
                }
            } 
        }
        stage('APPROVE DEPLOYMENT FOR PROD ') {
            input {
                message """ Approve production deployment Below :-
                        Chart: ${env.CHART_NAME}
                        Chart Version: ${env.CHART_VERSION}
                        App Version: ${env.APP_VERSION}
                        Namespace: prod
                        Image Version: ${env.IMAGE_TAG}
                        """
                id 'envId'
                ok 'APPROVE AND DEPLOY'
                submitterParameter 'approverId'
                parameters {
                    choice choices: ['Prod', 'Pre-Prod'], name: 'envType'
                }
            }

            steps {
                echo "Deployment approved to ${env.envType} by ${env.approverId}."
            }
        }
        stage("DEPLOY"){
            steps{
                container('cd-image') {
                    withCredentials([usernamePassword(credentialsId: 'nexus',usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) 
                    {
                        sh '''
                            cd k8s
                            
                            # 1. Download the exact package published to Nexus
                            curl --fail --silent --show-error \
                            --user "${NEXUS_USER}:${NEXUS_PASS}" \
                            --output "${CHART_NAME}-${CHART_VERSION}.tgz" \
                            "${CHART_REGISTRY}${CHART_NAME}-${CHART_VERSION}.tgz"

                            helm upgrade --install myapp \
                            "./${CHART_NAME}-${CHART_VERSION}.tgz" \
                            --namespace prod \
                            --wait
                        '''
                    }
               }   
            }
        }
    }
}
