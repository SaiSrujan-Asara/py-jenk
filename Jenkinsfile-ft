
pipeline {
    agent {
        kubernetes {
            yamlFile 'jenkins-agents/buildconfig.yaml'
            defaultContainer 'cd-image'
        }
    }


    stages {
        stage('Check FT access') {
            steps {
                sh '''
                    set -eu
                    kubectl version
                    kubectl auth can-i create deployments -n prod
                    kubectl get deployments -n prod
                '''
            }
        }
    }
}
